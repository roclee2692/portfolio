---
import LangSwitch from "@components/LangSwitch.astro";
import { SITE } from "@consts";
import { useTranslations, langPrefix, stripLang, type Lang } from "@i18n/ui";

type Props = { lang: Lang };
const { lang } = Astro.props;
const t = useTranslations(lang);
const p = langPrefix(lang);
const name = lang === "zh" ? SITE.NAME : SITE.NAME_EN;
const currentPath = stripLang(Astro.url.pathname);
const navigation = [
  { path: "/research", label: t("nav.research") },
  { path: "/projects", label: t("nav.projects") },
  { path: "/work", label: t("nav.work") },
];
---

<header>
  <div class="wrap flex items-center justify-between gap-4">
    <a href={`${p}/`} class="group flex items-center gap-2">
      <span class="grid h-8 w-8 place-items-center rounded-lg bg-accent/15 font-display text-sm font-bold text-accent transition-colors group-hover:bg-accent/25">
        {name.slice(0, 1)}
      </span>
      <span class="hidden font-display font-semibold text-black dark:text-white sm:inline">{name}</span>
    </a>
    <div class="flex items-center gap-2.5 sm:gap-5">
      <nav class="flex items-center gap-2.5 font-mono text-xs sm:gap-5 sm:text-sm" aria-label={lang === "zh" ? "主导航" : "Main navigation"}>
        {navigation.map(item => (
          <a href={`${p}${item.path}`} class="nav-link" aria-current={currentPath.startsWith(item.path) ? "page" : undefined}>{item.label}</a>
        ))}
      </nav>
      <LangSwitch />
    </div>
  </div>
</header>

---
import Link from "@components/Link.astro";
import LangSwitch from "@components/LangSwitch.astro";
import { SITE } from "@consts";
import { useTranslations, langPrefix, type Lang } from "@i18n/ui";

type Props = { lang: Lang };
const { lang } = Astro.props;
const t = useTranslations(lang);
const p = langPrefix(lang);
const name = lang === "zh" ? SITE.NAME : SITE.NAME_EN;
---

<header>
  <div class="wrap flex items-center justify-between gap-4">
    <a href={`${p}/`} class="group flex items-center gap-2">
      <span class="grid h-8 w-8 place-items-center rounded-lg bg-accent/15 font-display text-sm font-bold text-accent transition-colors group-hover:bg-accent/25">
        {name.slice(0, 1)}
      </span>
      <span class="font-display font-semibold text-black dark:text-white">{name}</span>
    </a>
    <div class="flex items-center gap-3 sm:gap-5">
      <nav class="flex items-center gap-4 font-mono text-sm sm:gap-5">
        <Link href={`${p}/research`}>{t("nav.research")}</Link>
        <Link href={`${p}/projects`}>{t("nav.projects")}</Link>
        <Link href={`${p}/work`}>{t("nav.work")}</Link>
      </nav>
      <LangSwitch />
    </div>
  </div>
</header>

---
import { useTranslations, type Lang } from "@i18n/ui";

type Props = { lang: Lang };
const { lang } = Astro.props;
const t = useTranslations(lang);
const repo = "https://github.com/roclee2692/MCM-ICM-2025-ProblemC";
---

<div class="reveal mt-10">
  <h3 class="font-display text-xl font-semibold text-black dark:text-white">{t("proofs.title")}</h3>
  <div class="mt-5 grid gap-4 md:grid-cols-2">
    <div class="card flex flex-col gap-3 p-5">
      <h4 class="font-semibold text-black dark:text-white">{t("proofs.math")}</h4>
      <p class="text-sm leading-relaxed">{t("proofs.math.desc")}</p>
      <div class="mt-auto flex flex-wrap gap-3 text-sm text-accent">
        <a href={`${repo}/blob/main/Competition_Paper.pdf`} target="_blank" rel="noopener noreferrer" class="hover:underline">{t("proofs.paper")} ↗</a>
        <a href={repo} target="_blank" rel="noopener noreferrer" class="hover:underline">{t("proofs.code")} ↗</a>
        <a href="/proofs/cumcm-2025.jpg" target="_blank" rel="noopener noreferrer" class="hover:underline">{t("proofs.award")} ↗</a>
      </div>
    </div>
    <div class="card flex flex-col gap-3 p-5">
      <h4 class="font-semibold text-black dark:text-white">{t("proofs.gis")}</h4>
      <p class="text-sm leading-relaxed">{t("proofs.gis.desc")}</p>
      <a href="/proofs/gis-training.jpg" target="_blank" rel="noopener noreferrer" class="mt-auto text-sm text-accent hover:underline">{t("proofs.gis.view")} ↗</a>
    </div>
  </div>
</div>

---
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import ProjectCard from "@components/ProjectCard.astro";
import ResearchCard from "@components/ResearchCard.astro";
import SectionHeader from "@components/SectionHeader.astro";
import AwardsList from "@components/AwardsList.astro";
import Proofs from "@components/Proofs.astro";
import HeroVisual from "@components/HeroVisual.astro";
import Link from "@components/Link.astro";
import { dateRange } from "@lib/utils";
import { FEATURED_PROJECTS, SITE, SOCIALS } from "@consts";
import { useTranslations, tf, langPrefix, type Lang } from "@i18n/ui";

type Props = { lang: Lang };
const { lang } = Astro.props;
const t = useTranslations(lang);
const lp = langPrefix(lang);
const name = lang === "zh" ? SITE.NAME : SITE.NAME_EN;

const allProjects = (await getCollection("projects")).filter(pr => !pr.data.draft);
const projects = FEATURED_PROJECTS.slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE)
  .map(slug => allProjects.find(project => project.slug === slug))
  .filter((project): project is NonNullable<typeof project> => Boolean(project));

const allResearch = (await getCollection("research")).filter(r => !r.data.draft);
const research = allResearch.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, SITE.NUM_RESEARCH_ON_HOMEPAGE);
const patentCount = allResearch.filter(r => r.data.type === "patent").length;

const allwork = (await getCollection("work")).filter(item => !item.data.draft).sort((a, b) => new Date(b.data.dateStart).valueOf() - new Date(a.data.dateStart).valueOf());
const work = await Promise.all(
  allwork.slice(0, SITE.NUM_WORKS_ON_HOMEPAGE).map(async (item) => {
    const { Content } = await item.render();
    return { ...item, Content };
  })
);

---

<PageLayout title={t("meta.home.title")} description={t("meta.home.desc")} bleed lang={lang}>
  {/* ══ 封面 Hero ══ */}
  <section class="hero-section relative flex min-h-[100svh] items-center overflow-hidden">
    <div class="wrap grid w-full items-center gap-14 pt-32 pb-24 lg:grid-cols-[1.02fr_0.98fr] lg:gap-16 lg:pt-36 lg:pb-32">
      <div>
        <div class="reveal inline-flex items-center gap-2 rounded-full border border-accent2/30 bg-accent2/5 px-3 py-1.5 font-mono text-xs text-accent2">
          <span class="status-dot"><span></span><span></span></span>
          {t("hero.badge")}
        </div>

        <h1 class="reveal mt-9 font-display font-semibold leading-[1.02] tracking-tight text-black dark:text-white" style="transition-delay:.08s">
          <span class="block text-lg font-medium tracking-normal text-black/55 dark:text-white/55 sm:text-xl">{t("hero.greeting")}</span>
          <span class:list={["hero-name mt-3 block", lang === "en" && "hero-name-en"]}>{name}<span class="text-accent" aria-hidden="true">.</span></span>
        </h1>

        <p class="reveal mt-5 font-display text-xl font-medium tracking-tight text-black/85 dark:text-white/85 sm:text-2xl" style="transition-delay:.12s">{t("hero.statement")}</p>

        <p class="reveal mt-5 font-mono text-xs uppercase tracking-wide text-accent sm:text-sm" style="transition-delay:.16s">
          {t("hero.role")}
        </p>

        <p class="reveal mt-6 max-w-xl text-base leading-relaxed sm:text-lg" style="transition-delay:.24s">
          {t("hero.tagline")}
        </p>

        <div class="reveal mt-9 flex flex-wrap items-center gap-3" style="transition-delay:.32s">
          <a href="#projects" class="group inline-flex items-center gap-3 rounded-full bg-accent px-6 py-3 text-sm font-medium text-white shadow-lg shadow-accent/25 transition-transform hover:-translate-y-0.5 dark:text-ink">
            {t("hero.viewProjects")}
            <span class="transition-transform group-hover:translate-x-0.5">→</span>
          </a>
          <a href="#contact" class="inline-flex items-center gap-2 rounded-full border border-[rgb(var(--line)/0.2)] px-5 py-2.5 text-sm font-medium text-black transition-colors hover:border-accent hover:text-accent dark:text-white">
            {t("hero.contact")}
          </a>
          <div class="ml-1 flex items-center gap-3 font-mono text-sm">
            {SOCIALS.map(s => (
              <Link href={s.HREF} external aria-label={`${name} on ${s.NAME}`}>{s.NAME}</Link>
            ))}
          </div>
        </div>

        <a href={`${lp}/resume`} class="resume-shortcut reveal group mt-7 flex w-full max-w-[22rem] items-center gap-3 rounded-2xl border border-[rgb(var(--line)/0.1)] bg-surface/60 px-4 py-3 transition-colors hover:border-accent/45" style="transition-delay:.4s">
          <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-accent/10 text-accent" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3.75h8l4 4V20.25H6z"/><path d="M14 3.75v4h4M9 12h6M9 15.5h6"/></svg>
          </span>
          <span class="min-w-0 flex-1">
            <span class="block text-sm font-medium text-black dark:text-white">{t("resume.cardTitle")}</span>
            <span class="mt-0.5 block text-xs text-black/55 dark:text-white/55">{t("resume.cardHint")}</span>
          </span>
          <span class="text-accent transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
        </a>
      </div>

      <HeroVisual lang={lang} projectCount={allProjects.length} patentCount={patentCount} />
    </div>

    <a href="#projects" class="absolute bottom-6 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-1 font-mono text-[10px] uppercase tracking-widest text-black/40 hover:text-accent dark:text-white/40 lg:flex">
      {t("hero.scroll")}
      <span class="animate-bob">↓</span>
    </a>
  </section>

  {/* ══ 精选项目 ══ */}
  <section id="projects" class="wrap scroll-mt-24 py-20 sm:py-28">
    <SectionHeader index="01" subtitle={t("section.projects.kicker")} title={t("section.projects.title")} href={`${lp}/projects`} linkLabel={t("common.viewAll")} />
    <ul class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {projects.map((project, i) => (
        <li class="reveal h-full" style={`transition-delay:${i * 90}ms`}>
          <ProjectCard entry={project} lang={lang} />
        </li>
      ))}
    </ul>
  </section>

  {/* ══ 专利与论文（青色区分） ══ */}
  <section class="relative overflow-hidden py-20 sm:py-28">
    <div class="absolute inset-0 -z-10 bg-gradient-to-b from-accent2/[0.04] to-transparent"></div>
    <div class="wrap-tight">
      <SectionHeader index="02" subtitle={t("section.research.kicker")} title={t("section.research.title")} href={`${lp}/research`} linkLabel={t("common.viewAll")} color="accent2" />
      <ul class="mt-10 grid gap-6 md:grid-cols-2">
        {research.map((item, i) => (
          <li class="reveal" style={`transition-delay:${i * 90}ms`}>
            <ResearchCard entry={item} lang={lang} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ══ 经历（横向时间线） ══ */}
  <section class="wrap py-20 sm:py-28">
    <SectionHeader index="03" subtitle={t("section.experience.kicker")} title={t("section.experience.title")} href={`${lp}/work`} linkLabel={t("common.viewAll")} />
    <div class="relative mt-12">
      <div class="absolute left-0 right-0 top-1.5 hidden h-px bg-gradient-to-r from-accent/40 via-[rgb(var(--line)/0.15)] to-transparent md:block"></div>
      <ol class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {work.map((entry, i) => (
          <li class="reveal relative md:pt-8" style={`transition-delay:${i * 90}ms`}>
            <span class="absolute left-0 top-0 hidden h-3 w-3 rounded-full border-2 border-accent bg-ink md:block"></span>
            <div class="font-mono text-xs text-accent">{tf(entry.data, "dateLabel", lang) || dateRange(entry.data.dateStart, entry.data.dateEnd, lang)}</div>
            <div class="mt-1 font-display text-lg font-semibold text-black dark:text-white">{tf(entry.data, "company", lang)}</div>
            <div class="text-sm opacity-70">{tf(entry.data, "role", lang)}</div>
            <article class="mt-2 text-sm">{lang === "zh" && entry.data.description_zh ? <p>{entry.data.description_zh}</p> : <entry.Content />}</article>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* ══ 工作方式 ══ */}
  <section class="wrap-tight py-16 sm:py-20">
    <SectionHeader index="→" subtitle={t("section.approach.kicker")} title={t("section.approach.title")} />
    <div class="reveal mt-8 max-w-3xl space-y-4 text-base leading-relaxed">
      <p>{t("section.approach.body")}</p>
      <p>{t("section.approach.team")}</p>
    </div>
  </section>

  {/* ══ 竞赛与荣誉 ══ */}
  <section class="wrap py-20 sm:py-28">
    <SectionHeader index="04" subtitle={t("section.awards.kicker")} title={t("section.awards.title")} color="accent2" />
    <div class="mt-10">
      <AwardsList lang={lang} />
    </div>
    <Proofs lang={lang} />
  </section>

  {/* ══ 联系 CTA ══ */}
  <section id="contact" class="wrap scroll-mt-24 pb-28 pt-8">
    <div class="reveal relative overflow-hidden rounded-3xl border border-[rgb(var(--line)/0.1)] p-8 sm:p-14">
      <div class="absolute inset-0 -z-10 bg-gradient-to-br from-accent/10 via-transparent to-accent2/10"></div>
      <div class="grid items-center gap-8 lg:grid-cols-[1.4fr_1fr]">
        <div>
          <h2 class="font-display text-3xl font-semibold text-black dark:text-white sm:text-4xl">
            {t("contact.title")}{lang === "en" ? " " : ""}<span class="text-gradient">{t("contact.titleAccent")}</span>
          </h2>
          <p class="mt-4 max-w-lg text-base leading-relaxed">{t("contact.body")}</p>
        </div>
        <div class="flex flex-col gap-3 font-mono text-sm">
          <a href={`mailto:${SITE.EMAIL}`} class="card flex items-center justify-between px-4 py-3 hover:text-accent">
            <span>{SITE.EMAIL}</span><span>✉</span>
          </a>
          <a href={`tel:${SITE.PHONE}`} class="card flex items-center justify-between px-4 py-3 hover:text-accent">
            <span>{SITE.PHONE}</span><span>☎</span>
          </a>
          {SOCIALS.map(s => (
            <a href={s.HREF} target="_blank" rel="noopener noreferrer" class="card card-teal flex items-center justify-between px-4 py-3 hover:text-accent2">
              <span>{s.NAME}</span><span>↗</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
</PageLayout>

---
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import ProjectCard from "@components/ProjectCard.astro";
import ResearchCard from "@components/ResearchCard.astro";
import SectionHeader from "@components/SectionHeader.astro";
import Link from "@components/Link.astro";
import { dateRange } from "@lib/utils";
import { SITE, SOCIALS } from "@consts";
import { useTranslations, tf, langPrefix, type Lang } from "@i18n/ui";

type Props = { lang: Lang };
const { lang } = Astro.props;
const t = useTranslations(lang);
const lp = langPrefix(lang);
const name = lang === "zh" ? SITE.NAME : SITE.NAME_EN;

const allProjects = (await getCollection("projects")).filter(pr => !pr.data.draft);
const projects = allProjects
  .sort((a, b) =>
    (Number(b.data.featured) - Number(a.data.featured)) ||
    (b.data.date.valueOf() - a.data.date.valueOf()))
  .slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE);

const allResearch = (await getCollection("research")).filter(r => !r.data.draft);
const research = allResearch.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, SITE.NUM_RESEARCH_ON_HOMEPAGE);
const patentCount = allResearch.filter(r => r.data.type === "patent").length;
const paperCount = allResearch.filter(r => r.data.type === "paper").length;

const allwork = (await getCollection("work")).sort((a, b) => new Date(b.data.dateStart).valueOf() - new Date(a.data.dateStart).valueOf());
const work = await Promise.all(
  allwork.slice(0, SITE.NUM_WORKS_ON_HOMEPAGE).map(async (item) => {
    const { Content } = await item.render();
    return { ...item, Content };
  })
);

const stats = [
  { k: "projects", v: String(allProjects.length).padStart(2, "0") },
  { k: "patents", v: String(patentCount).padStart(2, "0") },
  { k: "papers", v: `${paperCount}+` },
  { k: "stack", v: "Python · PyTorch · RAG" },
  { k: "location", v: t("stats.location") },
];
---

<PageLayout title={t("meta.home.title")} description={t("meta.home.desc")} bleed lang={lang}>
  {/* ══ 封面 Hero ══ */}
  <section class="relative flex min-h-[100svh] items-center overflow-hidden">
    <div class="wrap grid w-full items-center gap-10 pt-28 pb-24 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
      <div>
        <div class="reveal inline-flex items-center gap-2 rounded-full border border-accent2/30 bg-accent2/5 px-3 py-1 font-mono text-xs text-accent2">
          <span class="status-dot"><span></span><span></span></span>
          {t("hero.badge")}
        </div>

        <h1 class="reveal mt-6 font-display text-5xl font-semibold leading-[1.05] tracking-tight text-black dark:text-white sm:text-6xl lg:text-7xl" style="transition-delay:.08s">
          {t("hero.greeting")}
          <span class="mt-1 block text-gradient-shimmer">{name}</span>
        </h1>

        <p class="reveal mt-4 font-mono text-sm text-accent sm:text-base" style="transition-delay:.16s">
          {t("hero.role")}
        </p>

        <p class="reveal mt-6 max-w-xl text-base leading-relaxed sm:text-lg" style="transition-delay:.24s">
          {t("hero.tagline")}
        </p>

        <div class="reveal mt-8 flex flex-wrap items-center gap-3" style="transition-delay:.32s">
          <a href="#projects" class="group inline-flex items-center gap-2 rounded-full bg-accent px-5 py-2.5 text-sm font-medium text-white shadow-lg shadow-accent/25 transition-transform hover:-translate-y-0.5 dark:text-ink">
            {t("hero.viewProjects")}
            <span class="transition-transform group-hover:translate-x-0.5">→</span>
          </a>
          <a href="#contact" class="inline-flex items-center gap-2 rounded-full border border-[rgb(var(--line)/0.2)] px-5 py-2.5 text-sm font-medium text-black transition-colors hover:border-accent hover:text-accent dark:text-white">
            {t("hero.contact")}
          </a>
          <div class="ml-1 flex items-center gap-3 font-mono text-sm">
            {SOCIALS.map(s => (
              <Link href={s.HREF} external aria-label={`${name} on ${s.NAME}`}>{s.NAME}</Link>
            ))}
          </div>
        </div>
      </div>

      <div class="reveal relative" style="transition-delay:.4s">
        <div class="absolute -inset-4 -z-10 rounded-[2rem] bg-gradient-to-br from-accent/20 via-transparent to-accent2/20 blur-2xl"></div>
        <div class="card p-5 sm:p-6">
          <div class="flex items-center gap-2 border-b border-[rgb(var(--line)/0.1)] pb-3">
            <span class="h-3 w-3 rounded-full bg-red-400/80"></span>
            <span class="h-3 w-3 rounded-full bg-amber-400/80"></span>
            <span class="h-3 w-3 rounded-full bg-emerald-400/80"></span>
            <span class="ml-2 font-mono text-xs text-black/50 dark:text-white/50">~/portfolio.json</span>
          </div>
          <dl class="mt-4 space-y-3 font-mono text-sm">
            {stats.map(s => (
              <div class="flex items-center justify-between gap-4">
                <dt class="text-black/45 dark:text-white/45">{s.k}</dt>
                <dd class="truncate text-right text-black dark:text-white">{s.v}</dd>
              </div>
            ))}
            <div class="flex items-center justify-between gap-4 pt-1">
              <dt class="text-black/45 dark:text-white/45">status</dt>
              <dd class="flex items-center gap-1.5 text-accent2">
                <span class="status-dot"><span></span><span></span></span>{t("stats.status")}
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </div>

    <a href="#projects" class="absolute bottom-6 left-1/2 flex -translate-x-1/2 flex-col items-center gap-1 font-mono text-[10px] uppercase tracking-widest text-black/40 hover:text-accent dark:text-white/40">
      {t("hero.scroll")}
      <span class="animate-bob">↓</span>
    </a>
  </section>

  {/* ══ 精选项目 ══ */}
  <section id="projects" class="wrap scroll-mt-24 py-20 sm:py-28">
    <SectionHeader index="01" subtitle={t("section.projects.kicker")} title={t("section.projects.title")} href={`${lp}/projects`} linkLabel={t("common.viewAll")} />
    <ul class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {projects.map((project, i) => (
        <li class="reveal h-full" style={`transition-delay:${i * 90}ms`}>
          <ProjectCard entry={project} lang={lang} />
        </li>
      ))}
    </ul>
  </section>

  {/* ══ 专利与论文（青色区分） ══ */}
  <section class="relative overflow-hidden py-20 sm:py-28">
    <div class="absolute inset-0 -z-10 bg-gradient-to-b from-accent2/[0.04] to-transparent"></div>
    <div class="wrap-tight">
      <SectionHeader index="02" subtitle={t("section.research.kicker")} title={t("section.research.title")} href={`${lp}/research`} linkLabel={t("common.viewAll")} color="accent2" />
      <ul class="mt-10 grid gap-6 md:grid-cols-2">
        {research.map((item, i) => (
          <li class="reveal" style={`transition-delay:${i * 90}ms`}>
            <ResearchCard entry={item} lang={lang} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ══ 经历（横向时间线） ══ */}
  <section class="wrap py-20 sm:py-28">
    <SectionHeader index="03" subtitle={t("section.experience.kicker")} title={t("section.experience.title")} href={`${lp}/work`} linkLabel={t("common.viewAll")} />
    <div class="relative mt-12">
      <div class="absolute left-0 right-0 top-1.5 hidden h-px bg-gradient-to-r from-accent/40 via-[rgb(var(--line)/0.15)] to-transparent md:block"></div>
      <ol class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {work.map((entry, i) => (
          <li class="reveal relative md:pt-8" style={`transition-delay:${i * 90}ms`}>
            <span class="absolute left-0 top-0 hidden h-3 w-3 rounded-full border-2 border-accent bg-ink md:block"></span>
            <div class="font-mono text-xs text-accent">{dateRange(entry.data.dateStart, entry.data.dateEnd)}</div>
            <div class="mt-1 font-display text-lg font-semibold text-black dark:text-white">{tf(entry.data, "company", lang)}</div>
            <div class="text-sm opacity-70">{tf(entry.data, "role", lang)}</div>
            <article class="mt-2 text-sm"><entry.Content /></article>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* ══ 联系 CTA ══ */}
  <section id="contact" class="wrap scroll-mt-24 pb-28 pt-8">
    <div class="reveal relative overflow-hidden rounded-3xl border border-[rgb(var(--line)/0.1)] p-8 sm:p-14">
      <div class="absolute inset-0 -z-10 bg-gradient-to-br from-accent/10 via-transparent to-accent2/10"></div>
      <div class="grid items-center gap-8 lg:grid-cols-[1.4fr_1fr]">
        <div>
          <h2 class="font-display text-3xl font-semibold text-black dark:text-white sm:text-4xl">
            {t("contact.title")}{lang === "en" ? " " : ""}<span class="text-gradient">{t("contact.titleAccent")}</span>
          </h2>
          <p class="mt-4 max-w-lg text-base leading-relaxed">{t("contact.body")}</p>
        </div>
        <div class="flex flex-col gap-3 font-mono text-sm">
          <a href={`mailto:${SITE.EMAIL}`} class="card flex items-center justify-between px-4 py-3 hover:text-accent">
            <span>{SITE.EMAIL}</span><span>✉</span>
          </a>
          {SOCIALS.map(s => (
            <a href={s.HREF} target="_blank" rel="noopener noreferrer" class="card card-teal flex items-center justify-between px-4 py-3 hover:text-accent2">
              <span>{s.NAME}</span><span>↗</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
</PageLayout>

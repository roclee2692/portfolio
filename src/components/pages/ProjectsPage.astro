---
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import ProjectCard from "@components/ProjectCard.astro";
import SectionHeader from "@components/SectionHeader.astro";
import { useTranslations, type Lang } from "@i18n/ui";

type Props = { lang: Lang };
const { lang } = Astro.props;
const t = useTranslations(lang);

const projects = (await getCollection("projects"))
  .filter(project => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<PageLayout title={t("meta.projects.title")} description={t("meta.projects.desc")} lang={lang}>
  <div class="wrap">
    <SectionHeader index="→" subtitle={t("section.projects.kicker")} title={t("section.projects.title")} />
    <p class="reveal mt-3 max-w-xl">{t("meta.projects.desc")}</p>
    <ul class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {projects.map((project, i) => (
        <li class="reveal h-full" style={`transition-delay:${i * 80}ms`}>
          <ProjectCard entry={project} lang={lang} />
        </li>
      ))}
    </ul>
  </div>
</PageLayout>
